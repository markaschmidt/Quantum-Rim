# Quantum Rim environment
# Copy to `.env.local` and fill in. Never commit `.env.local`.

# Discord Activity client configuration (safe to expose in the Vite bundle).
# This is the Quantum Dash app ID for a shared single-Activity deployment.
# Use Quantum Rim's own app ID instead if both games should appear as separate
# Activity tiles inside the Vektre Labs Discord.
VITE_DISCORD_CLIENT_ID=1556122858298810400
# Leave blank for same-origin /api (recommended with Vercel or a URL mapping).
VITE_API_BASE_URL=

# Backend-only Discord OAuth configuration. Never add VITE_ to either secret.
DISCORD_CLIENT_ID=1556122858298810400
DISCORD_CLIENT_SECRET=
# Embedded Activities do not use the normal website callback redirect.
DISCORD_REDIRECT_URI=
# Optional dedicated signing key. When blank, the server derives signatures
# from DISCORD_CLIENT_SECRET without ever sending that secret to the browser.
SESSION_SECRET=
SESSION_TTL_HOURS=168
ALLOWED_ORIGINS=http://localhost:5173
# Local companion API. Quantum Dash uses 3001, so Rim uses 3002 by default.
PORT=3002

# FastAPI service used for event planning and Moth engine execution.
VITE_QUANTUM_SERVICE_URL=http://localhost:8000

# Unsplash Access Key — used ONLY at build time by scripts/fetch-images.mjs
# to download landing imagery into public/media/. Never bundled or exposed.
# Get one at: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
